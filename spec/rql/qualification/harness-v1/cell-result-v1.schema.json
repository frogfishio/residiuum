{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://residiuum.local/spec/rql/qualification/harness-v1/cell-result-v1.schema.json",
  "title": "residiuum-rql-qual-cell-result-v1",
  "type": "object",
  "required": [
    "cell_id",
    "lane",
    "pairing",
    "concurrency",
    "side_a",
    "side_b",
    "raw_repetitions",
    "scaffold_only"
  ],
  "properties": {
    "cell_id": { "type": "string" },
    "case_id": { "type": ["string", "null"] },
    "lane": {
      "type": "string",
      "enum": ["embedded", "local_client_server"]
    },
    "pairing": {
      "type": "object",
      "required": ["lane", "side_a", "side_b"],
      "properties": {
        "lane": { "type": "string" },
        "side_a": { "type": "string" },
        "side_b": { "type": "string" }
      }
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "description": "Plan-requested concurrency (§7.2 matrix)"
    },
    "achieved_concurrency": {
      "type": "integer",
      "minimum": 1,
      "description": "Peak simultaneous workers observed at execution (F10). Must equal concurrency when multi-worker path ran; must not stay 1 when plan asks for >1."
    },
    "side_a": {
      "type": "object",
      "description": "EngineRunOutcome; must include engine + execution_kind and status (ready|not_configured|feature_disabled|refused|unsupported)"
    },
    "side_b": {
      "type": "object",
      "description": "EngineRunOutcome; must include engine + execution_kind"
    },
    "equivalent": { "type": ["boolean", "null"] },
    "equivalence_detail": { "type": ["string", "null"] },
    "metrics_a": { "type": ["object", "null"] },
    "metrics_b": { "type": ["object", "null"] },
    "raw_repetitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repetition",
          "engine",
          "operations",
          "duration_ns",
          "valid",
          "result_digest",
          "query_hash",
          "index_config_hash",
          "cache_state"
        ]
      }
    },
    "scaffold_only": { "type": "boolean" }
  },
  "additionalProperties": true
}
