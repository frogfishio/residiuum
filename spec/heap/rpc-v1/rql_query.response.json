{
  "type": "object",
  "additionalProperties": false,
  "description": "Result for op 118 rql_query. Core returns rows directly; Full also returns the pre-attach base_rows and enrich load evidence.",
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["rql-app-core-v1", "rql-full-v1"]
    },
    "query_id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "plan_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "heap_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "collection_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "value": {}
        },
        "required": ["key", "value"]
      }
    },
    "base_rows": {
      "type": "array",
      "description": "Full profile only: underlying Application Core page before enrich/within/project attachment.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "value": {}
        },
        "required": ["key", "value"]
      }
    },
    "next": {
      "type": ["string", "null"],
      "maxLength": 65536
    },
    "exhausted": { "type": "boolean" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["complete", "incomplete_allowed"]
        }
      },
      "required": ["complete", "mode"]
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["available", "current"]
        }
      },
      "required": ["mode"]
    },
    "remaining_limit": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "logical_bytes_examined": {
      "type": "integer",
      "minimum": 0,
      "description": "Serialized logical JSON payload bytes successfully loaded by the QVM across Core and Full sources."
    },
    "known_holes": {
      "type": "array",
      "items": { "type": "object" }
    },
    "explain": {
      "type": "object",
      "description": "Present when request.explain is true; rows empty."
    },
    "stats": {
      "type": "object"
    },
    "enrich_loads": {
      "type": "array",
      "description": "Full profile only: actual foreign-load mode for each root enrich step.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "using": { "type": "string" },
          "output": { "type": "string" },
          "mode": {
            "type": "string",
            "enum": ["scan_list_keys_get", "equality_index"]
          }
        },
        "required": ["using", "output", "mode"]
      }
    }
  },
  "required": [
    "query_id",
    "plan_hash",
    "heap_id",
    "collection_id",
    "rows",
    "exhausted",
    "coverage",
    "consistency",
    "logical_bytes_examined"
  ]
}
