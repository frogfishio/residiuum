    "state_codes": {
      "0": "absent; no authoritative descriptor chain",
      "1": "active",
      "2": "retired"
    },
    "authority": "integrity-verified collection descriptor chain, never a rebuildable catalogue",
    "semantics": {
      "identity_reuse": "forbidden",
      "retirement": "monotonic in profile v1",
      "rename": "preserves lifecycle state and does not conflict",
