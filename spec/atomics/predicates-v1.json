    },
    "result_commitment": "domain-separated hash of collection_id, cardinality, and canonically ordered (key_identity, establishing_version) pairs",
    "coverage": {
      "authoritative_primary_only": true,
      "offline_or_unknown_key_authority": "coverage_incomplete",
      "examination_limit_exceeded": "coverage_incomplete",
      "candidate_partial_or_damaged_derived_index": "cannot prove the predicate"
    }
  },
  "active_rule_revision": {
    "outer_predicate_kind": 7,
    "outer_fields": {
      "collection_id": "absent",
      "key": "absent",
      "version": "absent",
      "encoded": "required bstr(32), nonzero invariant revision"
    },
    "plan_active_rule_revisions": "the exact strictly sorted, duplicate-free, nonzero active set",
    "authoritative_record": {
      "scope": "one Heap",
      "subject": "SubjectV2 HeapMetadata / zero object id / residiuum-active-rule-set-v1",
      "encoding": "deterministic CBOR map {1: profile=1, 2: strictly sorted array of bstr(32)}",
      "missing": "empty active set",
      "empty": "stored explicitly; never represented as a deletion alias"
