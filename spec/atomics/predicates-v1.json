      "7": { "name": "upper", "type": "canonical_key_map", "required": true },
      "8": { "name": "upper_inclusive", "type": "uint(0|1)", "required": true },
      "9": { "name": "coverage_domain", "type": "bstr(32)", "required": true },
      "10": { "name": "examination_limit", "type": "uint", "required": true, "range": "1..=1000000" },
