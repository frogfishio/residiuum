    {"id":"wrong_graph_record","mutation":"change _rgraph.graph","expect":"graph_record_mismatch"},
    {"id":"wrong_definition_record","mutation":"change _rgraph.definition","expect":"graph_record_mismatch"},
    {"id":"wrong_generation_record","mutation":"change _rgraph.generation","expect":"graph_record_mismatch"},
    {"id":"wrong_type_record","mutation":"change _rgraph.type","expect":"graph_record_mismatch"},
    {"id":"strict_missing_endpoint","mutation":"remove module/d before validation","expect":"graph_endpoint_missing"},
    {"id":"deferred_missing_endpoint","definition_mutation":"change DependsOn endpoint_policy to deferred, re-canonicalize the definition, and replace every record definition revision with the new revision","record_mutation":"remove module/d before validation","expect":"validation succeeds with a graph_endpoint_missing violation and incomplete coverage"},
    {"id":"definition_revision_flip","mutation":"flip final definition revision byte","expect":"graph_definition_damaged"},
    {"id":"missing_adjacency_empty","mutation":"remove the published outbound adjacency artifact","expect":"fallback_or_coverage_incomplete_never_complete_empty"},
    {"id":"unpublished_adjacency_ignored","mutation":"place a valid artifact without publishing its manifest","expect":"artifact ignored and fallback_or_coverage_incomplete"},
    {"id":"parallel_edges_preserved","mutation":"none","expect":"both depends/a/b edges returned"},
    {"id":"self_loop_two_directions","mutation":"none","expect":"outgoing and incoming rows retained under both"}
  ]
}
