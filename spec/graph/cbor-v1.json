    "2": { "field": "heap_id", "type": "bstr(16)" },
    "3": { "field": "graph_id", "type": "bstr(16)" },
    "4": { "field": "definition_revision", "type": "bstr(32)" },
    "5": { "field": "generation_id", "type": "bstr(16)" },
    "6": { "field": "build_id", "type": "bstr(16)", "rule": "non-zero UUIDv4" },
    "7": { "field": "generation_content_root", "type": "bstr(32)" },
    "8": { "field": "artifacts", "type": "array", "rule": "one adjacency_artifact per declared edge collection and direction, sorted by collection_id then direction" },
    "9": { "field": "complete", "type": "bool", "rule": "exactly true in a published manifest" }
  },
  "violation": {
    "1": { "field": "code", "type": "text" },
    "2": { "field": "kind", "type": "uint", "rule": "1 vertex, 2 edge" },
    "3": { "field": "collection_id", "type": "bstr(16)" },
