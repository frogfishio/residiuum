    "4": { "field": "direction", "type": "uint", "rule": "1 outgoing, 2 incoming" },
    "5": { "field": "payload_root", "type": "bstr(32)" },
    "6": { "field": "entry_count", "type": "uint" },
    "7": { "field": "generation_content_root", "type": "bstr(32)" },
    "8": { "field": "block_count", "type": "uint" },
    "9": { "field": "complete", "type": "bool" }
  },
  "adjacency_manifest": {
